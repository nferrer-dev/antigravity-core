++---
++name: upload-to-gdrive
++description: Automatically convert and upload generated readable documents to Google Drive. Use this whenever you generate a long readable document (like an analysis, story, plan, or research report) that the user might want to read away from the computer.
++---
++
++# Instructions
++
++When you generate a readable document for the user, you MUST automatically upload a copy to their Google Drive as a `.docx` file. 
++
++To do this, you must run the `md_to_gdrive.py` script provided in this skill's `scripts/` directory.
++
++### Command Format
++```bash
++python "<absolute_path_to_this_skill_directory>\scripts\md_to_gdrive.py" "<absolute_path_to_markdown_file>" "[optional_document_title]"
++```
++
++* `<absolute_path_to_markdown_file>`: The path to the generated document artifact (e.g. `C:\Users\spurd\.gemini\antigravity\brain\...\my_document.md`).
++* `[optional_document_title]`: (Optional) The name you want the `.docx` file to have in Google Drive. If omitted, it will use the original markdown file's basename.
++
++### Example
++```bash
++python "<absolute_path_to_this_skill_directory>\scripts\md_to_gdrive.py" "C:\Users\spurd\.gemini\antigravity\brain\12345\analysis.md" "Analysis Report"
++```
+diff --git a/skills/upload-to-gdrive/scripts/md_to_gdrive.py b/skills/upload-to-gdrive/scripts/md_to_gdrive.py
+new file mode 100644
+index 0000000..0d70393
+--- /dev/null
++++ b/skills/upload-to-gdrive/scripts/md_to_gdrive.py
+@@ -0,0 +1,55 @@
++import sys
++import os
++import pypandoc
++import shutil
++import re
++
++def main():
++    if len(sys.argv) < 2:
++        print("Usage: python md_to_gdrive.py <absolute_path_to_markdown_file> [optional_document_title]")
++        sys.exit(1)
++
++    input_file = sys.argv[1]
++    title = sys.argv[2] if len(sys.argv) > 2 else None
++
++    if not os.path.exists(input_file):
++        print(f"Error: File not found: {input_file}")
++        sys.exit(1)
++
++    # Make sure pandoc is available
++    try:
++        pypandoc.get_pandoc_version()
++    except OSError:
++        print("Pandoc not found. Downloading...")
++        pypandoc.download_pandoc()
++
++    # Determine filename
++    base_name = os.path.basename(input_file)
++    name_without_ext = os.path.splitext(base_name)[0]
++    
++    if title:
++        # Sanitize title for filename
++        safe_title = re.sub(r'[<>:"/\\|?*]', '', title).strip()
++        if safe_title:
++            name_without_ext = safe_title
++            
++    output_filename = f"{name_without_ext}.docx"
++    
++    # Save to a temporary location first
++    temp_output = os.path.join(os.environ.get("TEMP", "."), output_filename)
++    
++    print(f"Converting {input_file} to DOCX...")
++    pypandoc.convert_file(input_file, 'docx', outputfile=temp_output)
++    print(f"Successfully converted to {temp_output}")
++    
++    # Copy to Google Drive if available
++    gdrive_path = r"G:\My Drive"
++    if os.path.exists(gdrive_path):
++        target_path = os.path.join(gdrive_path, output_filename)
++        shutil.copy2(temp_output, target_path)
++        print(f"Successfully uploaded to Google Drive: {target_path}")
++    else:
++        print(f"Warning: Google Drive not found at {gdrive_path}. File left at {temp_output}")
++
++if __name__ == "__main__":
++    main()
