{
  "brc-and-secret-guard": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command|execute_command|Bash|manage_task|send_command_input|view_file|view_file_outline|view_code_item|read_file|grep_search|Grep|find_by_name|list_(?:dir|resources)|(?:multi_)?replace_file_content|edit_file|write_to_file|write_file|(?:Multi)?Edit|Write|Read|invoke_subagent|define_subagent|send_message|schedule|read_url_content|WebFetch|call_mcp_tool|mcp_cortex_.*|mcp__cortex__.*",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File ./hooks/brc-guard.ps1",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "causal-telemetry-append": {
    "enabled": true,
    "Stop": [
      {
        "type": "command",
        "command": "powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File ./hooks/telemetry-append.ps1",
        "timeout": 5
      }
    ]
  }
}
