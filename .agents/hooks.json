{
  "brc-and-secret-guard": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command|execute_command|Bash|view_file|(?:multi_)?replace_file_content|write_to_file|(?:Multi)?Edit|Write|Read|invoke_subagent|send_message|schedule|read_url_content|WebFetch|call_mcp_tool",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File ./hooks/brc-guard.ps1",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "causal-telemetry-append": {
    "enabled": true,
    "Stop": [
      {
        "type": "command",
        "command": "powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File ./hooks/telemetry-append.ps1",
        "timeout": 5
      }
    ]
  }
}
